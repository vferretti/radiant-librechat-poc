# =============================================================================
# LibreChat — POC Radiant · variables d'environnement
# Copier vers .env à côté du docker-compose de LibreChat, puis remplir les
# valeurs. NE JAMAIS COMMITER LE .env RÉEL (secrets).
# Générer les valeurs aléatoires avec : openssl rand -hex 32 (ou 16 pour CREDS_IV)
# =============================================================================

HOST=localhost
PORT=3080
DOMAIN_CLIENT=http://localhost:3080
DOMAIN_SERVER=http://localhost:3080
# UID/GID de l'utilisateur hôte (id -u / id -g) — évite les fichiers root dans les volumes
UID=1000
GID=1000

MONGO_URI=mongodb://mongodb:27017/LibreChat
MEILI_MASTER_KEY=<openssl rand -hex 24>
ADMIN_PANEL_SESSION_SECRET=<openssl rand -hex 24>
# Le panneau admin prend le port 3000 par défaut — conflit avec le portail Radiant
ADMIN_PANEL_PORT=3090

# Chiffrement des credentials stockés (Mongo) et sessions
CREDS_KEY=<openssl rand -hex 32>
CREDS_IV=<openssl rand -hex 16>
JWT_SECRET=<openssl rand -hex 32>
JWT_REFRESH_SECRET=<openssl rand -hex 32>

# --- Authentification -------------------------------------------------------
# POC : login local en secours ; production : OPENID seul + AUTO_REDIRECT
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=true
ALLOW_SOCIAL_LOGIN=true

# SSO Keycloak (zone qlin)
OPENID_ISSUER=https://auth.dev.qlin.aws.sante.quebec/realms/qlin
OPENID_CLIENT_ID=radiant
OPENID_CLIENT_SECRET=<secret du client Keycloak — demander à l'équipe plateforme>
OPENID_SESSION_SECRET=<openssl rand -hex 32>
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_USE_PKCE=true
# Production : décommenter pour rediriger automatiquement vers Keycloak
# OPENID_AUTO_REDIRECT=true

# --- Modèle -----------------------------------------------------------------
ENDPOINTS=anthropic,agents
# POC hors zone : clé API Anthropic (console platform.claude.com).
# `user_provided` = chaque utilisateur saisit la sienne dans l'UI.
ANTHROPIC_API_KEY=<sk-ant-... ou user_provided>

# Cible zone d'accueil : remplacer par Bedrock (aucune clé, rôle IAM)
# ENDPOINTS=bedrock,agents
# BEDROCK_AWS_DEFAULT_REGION=ca-central-1
# (credentials via rôle IAM du conteneur — ne rien mettre ici)

NO_INDEX=true
DEBUG_LOGGING=true
